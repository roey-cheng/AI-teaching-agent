# 可选：合并到 backend/.env，不要覆盖已有 DB_*/MODEL_*/LANGSMITH_*。
# 本地开发默认值。列表使用 JSON；地址不带结尾 /。
HTTP_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
HTTP_COOKIE_SECURE=false

# 部署时改为真实 HTTPS 页面来源，并启用 Secure Cookie，例如：
# HTTP_ALLOWED_ORIGINS=["https://chat.example.com"]
# HTTP_COOKIE_SECURE=true
