# 本地 MySQL。部署到 Railway 时用平台变量覆盖，不提交真实值。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_teaching_assistant
DB_USER=ai_teaching_app
DB_PASSWORD=replace-with-a-local-database-password

# 正式聊天当前只登记了这个已核对容量的模型名。
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-pro
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=replace-with-your-deepseek-key

# 本地网页来源；生产值见部署文档。
HTTP_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
HTTP_COOKIE_SECURE=false
HTTP_REQUIRE_TRUSTED_PROXY=false
HTTP_PROXY_SHARED_SECRET=

# 本地默认不要求人机验证；生产环境必须开启。
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=register

# 持久化到 MySQL 的模型调用保护；按 UTC 日期重置每日额度。
GENERATION_USER_DAILY_LIMIT=30
GENERATION_GLOBAL_DAILY_LIMIT=500
GENERATION_GLOBAL_CONCURRENCY_LIMIT=2

# 可选。开启后可能把提示、对话和记忆上传至 LangSmith。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-teaching-agent-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
