# 将本节追加到 backend/.env；不要覆盖已有 DB_* 和 MODEL_*。
# 开启后，对话、系统提示、个人记忆及模型输出可能上传到 LangSmith。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-teaching-agent-dev
# US；EU 账号使用 https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 仅当 API Key 需要指定工作区时填写。
LANGSMITH_WORKSPACE_ID=
